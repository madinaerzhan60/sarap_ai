# Application
APP_ENV=development
APP_BASE_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:8000
# Optional only when API is hosted on a different origin. Empty uses same-origin.
API_URL=

# Supabase — create separate projects for development and production.
# The service-role key is backend-only and must never be added to frontend/config.js.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SARAP_ADMIN_EMAIL=
SARAP_TEST_EMAIL=

# AI cascade: Groq handles the fast pass, Gemini handles difficult cases.
GROQ_API_KEY=
GROQ_FAST_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_STRONG_MODEL=gemini-flash-latest
LLM_FAST_PROVIDER=groq
LLM_STRONG_PROVIDER=gemini
LLM_CONFIDENCE_THRESHOLD=0.80

# Free web discovery without a paid search API.
# GDELT is used for news; RSS, sitemaps and monitored URLs use SARAP connectors.
WEB_SEARCH_PROVIDER=free
GDELT_API_BASE=https://api.gdeltproject.org/api/v2/doc/doc
GOOGLE_NEWS_RSS_BASE=https://news.google.com/rss/search
COMMON_CRAWL_COLLINFO_URL=https://index.commoncrawl.org/collinfo.json

# Focused crawler for URLs added by a business.
CRAWLER_USER_AGENT=SARAPBot/0.1 (+https://sarap.ai/bot)
CRAWLER_TIMEOUT_SECONDS=20
CRAWLER_MAX_CONCURRENCY=3
CRAWLER_RESPECT_ROBOTS_TXT=true
CRAWLER_MAX_RESPONSE_BYTES=2000000
# Optional comma-separated allowlist. Empty permits any public host.
CRAWLER_ALLOWED_HOSTS=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
POLL_HIGH_ACTIVITY_MINUTES=7
POLL_MEDIUM_ACTIVITY_MINUTES=20
POLL_LOW_ACTIVITY_MINUTES=45
WEB_DISCOVERY_INTERVAL_HOURS=24

# Google Business and Instagram OAuth tokens are stored per source in Supabase.
# These values only configure the shared Meta API endpoint, never a customer token.
META_GRAPH_API_BASE=https://graph.facebook.com
META_GRAPH_API_VERSION=v23.0

# Telegram — one bot token for SARAP. Individual chat IDs belong in Supabase.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Risk and encryption.
ALERT_RISK_THRESHOLD=60
SOURCE_TOKEN_ENCRYPTION_KEY=

# Modular collector worker. Use comma-separated Webshare proxy URLs.
SCRAPER_BUSINESS_ID=
SCRAPER_MAX_PARALLEL=3
SCRAPER_JOBS_JSON=[]
WEBSHARE_PROXY_URLS=
# Optional when Chromium is installed outside Playwright's default cache.
PLAYWRIGHT_CHROMIUM_EXECUTABLE=
YOUTUBE_API_KEY=
# Without a Google key, YouTube comments fall back to SOCIAVAULT_API_KEY.
YOUTUBE_MAX_VIDEOS_PER_SYNC=2
YOUTUBE_COMMENTS_PER_SYNC=100
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=sarap-telegram
THREADS_STORAGE_STATE=
TIKTOK_STORAGE_STATE=

# Provider selection for sources (direct, brightdata, scraperapi, apify)
TWOGIS_PROVIDER=direct
YANDEX_PROVIDER=direct
INSTAGRAM_PROVIDER=direct

# Bright Data credentials (optional)
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=

# ScraperAPI credentials (optional)
SCRAPERAPI_KEY=

# Apify credentials (optional)
APIFY_TOKEN=
APIFY_TWOGIS_ACTOR_ID=
APIFY_YANDEX_ACTOR_ID=
APIFY_INSTAGRAM_ACTOR_ID=

# 2GIS fallback: Playwright -> Scrapfly -> Apify.
SCRAPFLY_API_KEY=
SCRAPFLY_COUNTRY=kz

# Instagram fallback: Playwright -> SociaVault -> SocialCrawl -> Apify.
SOCIAVAULT_API_KEY=
SOCIALCRAWL_API_KEY=

# Apify is the paid last fallback. Actor IDs stay configurable because Store
# actors can be renamed, replaced, or use different input schemas.
APIFY_API_TOKEN=
APIFY_2GIS_ACTOR_ID=getascraper/2gis-reviews-scraper
APIFY_INSTAGRAM_ACTOR_ID=
APIFY_2GIS_INPUT_JSON=
APIFY_INSTAGRAM_INPUT_JSON=
APIFY_MAX_ITEMS_PER_RUN=1000
APIFY_RUN_TIMEOUT_SECONDS=300

FALLBACK_RETRY_ATTEMPTS=2
COLLECTOR_BATCH_SIZE=250
PLAYWRIGHT_MAX_SCROLLS=200

# Collection safety: paid providers are never called unless both switches are true.
ENABLE_PAID_FALLBACKS=false
ENABLE_APIFY=false
ENABLE_SCRAPFLY=false
APIFY_MAX_CALLS_PER_BUSINESS_PER_DAY=2
PROVIDER_FAILURE_THRESHOLD=3
PROVIDER_COOLDOWN_MINUTES=60
INITIAL_REVIEW_LIMIT=500
PLAYWRIGHT_SCROLL_WAIT_MS=900

# Preferred self-hosted public discovery provider.
SEARXNG_URL=

# Optional browser worker for Playwright-heavy sources (2GIS/Google/Yandex).
COLLECTOR_WORKER_URL=
COLLECTOR_WORKER_TOKEN=
